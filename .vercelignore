# Vercel CLI only falls back to .gitignore when this file does NOT exist.
# Because this file exists, every exclusion the deployment needs must be listed here.
# Paths are gitignore syntax: a leading "/" anchors to the repo root.
# Do NOT drop the leading slash on /docs/ or /output/ — unanchored "docs/" would
# also match the real Next.js route src/app/docs/.

# Remote builds install dependencies themselves. Local `vercel build --prod` emits
# filePathMap entries for these traced runtime packages, so prebuilt uploads must
# include exactly this allowlist instead of dropping node_modules wholesale.
node_modules/*
!node_modules/@swc/
node_modules/@swc/*
!node_modules/@swc/helpers/
!node_modules/@swc/helpers/**
!node_modules/client-only/
!node_modules/client-only/**
!node_modules/next/
!node_modules/next/**
!node_modules/react/
!node_modules/react/**
!node_modules/react-dom/
!node_modules/react-dom/**
!node_modules/styled-jsx/
!node_modules/styled-jsx/**

# Prebuilt deployments need the traced .next runtime files referenced by
# .vercel/output/functions/*/.vc-config.json. Keep only stale snapshots ignored.
/.next.bak-*/
/out/
/build

# local tooling binaries (tools/bin/cloudflared.exe alone is ~52 MB)
/tools/

# local scratch, diagnostics and captures
/tmp/
/sub2api-local/
/output/
/test-results/
/.playwright-cli/
/coverage/
/.next-start.log
/.next-dev-*.log

# local tooling home / caches / heavy non-deploy artifacts (workbuddy-linux alone is 1.9G,
# including a 449MB wb.dmg that trips Vercel's 100MB per-file limit)
/.tmp-home/
/.tmp-vercel-cache/
/.tmp-vercel-config/
/workbuddy-linux/
/.dsh-ssh/
/.dsh-vision-router/
/.tsdeps/
/.pixai-refresh/
/browser-probe/
/browser-screenshots/
/pixai-pool-new.json
/dreamina_output.webp
/deploy_out.log

# documentation & design assets (build-time only; no runtime code reads these)
/docs/
/design-system/
/deploy/

# tests are never executed on Vercel
**/*.test.ts
**/*.test.tsx

# vcs & local env
.git
.gitignore
*.tsbuildinfo
.env*
