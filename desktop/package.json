{
  "name": "eimu-desktop",
  "productName": "Eimu",
  "version": "0.3.0",
  "private": true,
  "description": "Eimu 桌面客户端",
  "author": "Eimu",
  "license": "UNLICENSED",
  "desktopName": "eimu.desktop",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "dev.eimu.desktop",
    "productName": "Eimu",
    "copyright": "Copyright © 2026 Eimu",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "window-controls.js",
      "local-worker.js",
      "device-bridge-client.js",
      "lib/**",
      "build/icon.png"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics",
      "icon": "build/icon.png",
      "synopsis": "AI 创作工作台",
      "description": "Eimu 桌面客户端",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Eimu"
    }
  }
}
