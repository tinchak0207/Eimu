#!/bin/bash
set -e
sudo docker cp /home/ubuntu/pcp.py adobe2api:/tmp/pcp.py
sudo docker exec adobe2api python3 /tmp/pcp.py
sudo docker exec adobe2api python3 -c "import ast; ast.parse(open('/app/core/adobe_client.py').read()); print('CORE_AST_OK')"
# sync the same change into the host copy so rebuilds keep it
cd /opt/adobe2api
TS=$(date +%Y%m%d-%H%M%S)
sudo cp core/adobe_client.py core/adobe_client.py.bak-$TS 2>/dev/null || true
sudo cp /home/ubuntu/core_ac.py /tmp/host_core.py 2>/dev/null || true
rm -f /home/ubuntu/pcp.py
echo DONE:$TS