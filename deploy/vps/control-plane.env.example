NODE_ENV=production
GENERATION_CONTROL_PLANE_ENABLED=true
GENERATION_POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_DATABASE_PASSWORD
GENERATION_DATABASE_URL=postgres://image_control:REPLACE_WITH_LONG_RANDOM_DATABASE_PASSWORD@generation-postgres:5432/image_control
GENERATION_PROMPT_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_OR_64_HEX_KEY
GENERATION_DATABASE_POOL_SIZE=5
GENERATION_SUPPLIER_CONCURRENCY=4
GENERATION_ACCOUNT_CONCURRENCY=2
GENERATION_CAPABILITY_CONCURRENCY=2
GENERATION_JOB_LEASE_MS=120000
GENERATION_SUPPLIER_LEASE_MS=120000
GENERATION_WORKER_POLL_MS=1000
GENERATION_SUPPLIER_TIMEOUT_MS=100000
ADOBE2API_HEALTH_PATH=health
CALLBACK_HMAC_KEY_VERSION=v1
CALLBACK_HMAC_SECRET_V1=REPLACE_WITH_RANDOM_CALLBACK_SIGNING_SECRET
