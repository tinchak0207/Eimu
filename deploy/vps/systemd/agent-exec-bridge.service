# exec-bridge（S12，设计文档 §3.6）：让网关调用只活在 opencode 进程树里的 music_gen / blender_render。
# 只监听 127.0.0.1:8767（8765=blender 桥，8890-8899=zen 代理池，18893=groq 隧道，均已避开）。
# 部署（本文件只是真源，不在生产启用；启用由 orchestrator 执行）：
#   sudo install -m 644 agent-exec-bridge.service /etc/systemd/system/agent-exec-bridge.service
#   sudo install -d -o agentsvc -g agentsvc /opt/agent-harness/workspace/.opencode/exec-bridge
#   sudo cp <repo>/deploy-staging/opencode-runtime/exec-bridge/server.ts /opt/agent-harness/workspace/.opencode/exec-bridge/server.ts
#   sudo systemctl daemon-reload && sudo systemctl enable --now agent-exec-bridge
# token 不内嵌：HARNESS_INTERNAL_TOKEN 来自 EnvironmentFile（与 opencode-server / 网关同一把）；缺失则进程拒绝启动。
# server.ts 用相对路径 ../tools/music_gen 与 ../lib/blender-tools-adapter，因此必须放在 workspace/.opencode/ 树下。
[Unit]
Description=Eimu exec-bridge (music_gen / blender_render for the gateway)
After=network-online.target opencode-server.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=agentsvc
Group=agentsvc
WorkingDirectory=/opt/agent-harness/workspace
# 与 opencode-server 同一份运行时环境（HARNESS_INTERNAL_TOKEN、GATEWAY_URL、IMAGE_DATA_*、BLENDER_BRIDGE_* 等）
EnvironmentFile=/opt/agent-harness/.env.opencode
# 可选覆盖（端口/workspace）；文件不存在不报错
EnvironmentFile=-/opt/agent-harness/.env.exec-bridge
Environment=WORKSPACE_DIR=/opt/agent-harness/workspace
Environment=EXEC_BRIDGE_PORT=8767
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# bun 的实际路径以 VPS 为准（部署时 `command -v bun` 核对）；env 方式依赖上面的 PATH
ExecStart=/usr/bin/env bun run /opt/agent-harness/workspace/.opencode/exec-bridge/server.ts
Restart=on-failure
RestartSec=5s

# 与 opencode-server 同一收紧：只写 workspace（落盘在别处会 SQLITE_CANTOPEN/Permission denied，见记忆 2026-10-15）
ProtectSystem=strict
ReadWritePaths=/opt/agent-harness/workspace
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
# 4GB 主机上别让桥拖垮大脑：全局 OOM 时先杀桥，保护 opencode-server(-500)
OOMScoreAdjust=300
MemoryMax=600M
MemorySwapMax=0

[Install]
WantedBy=multi-user.target
