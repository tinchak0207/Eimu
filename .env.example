# 复制为 .env.local（本地）或 .env.production（部署），填入你自己的值。
# 仓库不包含任何可用凭据。所有 REPLACE_WITH_* 都必须替换。

NODE_ENV=development

# ── 站点 ─────────────────────────────────────────────────────────────
# 对外访问地址与内部网关地址
NEXT_PUBLIC_SITE_URL=http://localhost:3000
GATEWAY_URL=http://127.0.0.1:8787
GATEWAY_BASE_URL=http://127.0.0.1:8787
AGENT_GATEWAY_ORIGIN=http://127.0.0.1:8787

# 会话与签名
ADMIN_SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
HARNESS_INTERNAL_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET

# ── 生成控制面（Postgres）─────────────────────────────────────────────
GENERATION_CONTROL_PLANE_ENABLED=true
GENERATION_DATABASE_URL=postgres://eimu:REPLACE_WITH_PASSWORD@127.0.0.1:5432/eimu
GENERATION_PROMPT_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_OR_64_HEX_KEY
GENERATION_DATABASE_POOL_SIZE=5
GENERATION_SUPPLIER_CONCURRENCY=4
GENERATION_ACCOUNT_CONCURRENCY=2
GENERATION_CAPABILITY_CONCURRENCY=2
GENERATION_JOB_LEASE_MS=120000
GENERATION_SUPPLIER_LEASE_MS=120000
GENERATION_WORKER_POLL_MS=1000
GENERATION_SUPPLIER_TIMEOUT_MS=100000

# 站点与计费中继之间的共享密钥（两侧必须一致）
GENERATION_BILLING_RELAY_URL=http://127.0.0.1:3000/api/internal/generation-billing
GENERATION_BILLING_RELAY_SECRET=REPLACE_WITH_DIFFERENT_LONG_RANDOM_SECRET
CALLBACK_HMAC_KEY_VERSION=v1
CALLBACK_HMAC_SECRET_V1=REPLACE_WITH_RANDOM_CALLBACK_SIGNING_SECRET

# ── 对象存储 ─────────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=REPLACE_WITH_YOUR_STORAGE_TOKEN

# ── 上游供应商（只填你实际接入的）────────────────────────────────────
# 未配置的渠道不会参与路由
NEWAPI_BASE_URL=
NEWAPI_API_KEY=
GEMINI_API_KEY=
GEMINI_STUDIO_API_KEY=
EXA_API_KEY=
METASO_API_KEY=
CANGYUANSUANLI_API_KEY=

# ── 登录 ─────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 微信登录需要你自备的扫码服务；没有就留空，相关入口不会显示
WECHAT_MP_QR_SERVER=
WECHAT_WORKER_NEW_QR_URL=

# ── 可选 ─────────────────────────────────────────────────────────────
# 桌面端设备桥与本地执行器
HARNESS_WORKSPACE=
WORKSPACE_DIR=
# Agent 记忆导入
MEMORY_INGEST_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
