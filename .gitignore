# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/.playwright-cli
/output/playwright

# next.js
/.next/
/.next.bak-*/
/out/

# production
/build

# misc
.DS_Store
*.pem
# 例外：vendored certifi 的 CA bundle 是套件資料檔，必須隨 vendor 一起進版控／部署
!deploy-staging/opencode-runtime/lib/smartsearch/certifi/cacert.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next-dev-*.log
/.next-start.log

# local diagnostics
/tmp
/sub2api-local
/output/
/tools/bin/

# env files (can opt-in for committing if needed)
.env*

# account pool credentials
/pixai-pool/**/pool.json
/pixai-pool/bridge/.lease

# python caches
__pycache__/
*.pyc

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.claude/

# 部署用的业务 key 脚本：内含凭证，永不入库
tools/.deploy-bizkey.sh
.env*.local
workbuddy-linux/

# 敏感/運行時雜訊（勿入庫）
.pixai-refresh/
pixai-pool/
.vercel-cli-data/
.agent-runs/
.tools/
.env*
!deploy/vps/control-plane.env.example

# 本地工具 HOME / 快取 / 快照（曾整包入庫 160MB+，禁止再入）
/.tmp-home/
/.vercel.bak-link/
/.dsh-ssh/
/.dsh-adobe-pool/
/.tsdeps/
/.xdg-cache/
/.gateway-work/
/.vercel-home/
/.vercel-cli-cache/
/.tmp-vercel-cache/
/.dsh-mem/
/.agents-fix/
/sudo.conf.backup
/marketing-battle-pack/
/eval-daming-film/

# 本機憑證備份（.env 同源，永不入庫）
.credentials.bak.yaml

# ── 一次性診斷/評測/暫存（2026-09-04 commit 瘦身）──
.zcode/
.tmp-*/
eval-*/
surgery/
/*.mp4
/*.mjs
chapters.tsv

# Blender headless sandbox workdir (bridge/blender-bridge)
.blender-work/

# ── 根目錄暴露面清理（2026-09-06）：log/測試/redteam/內部資料永不入庫 ──
*.log
*.err
.redteam-*
redteam-*
.browser-screenshots/
/browser-probe/
/browser-screenshots/
/verification/
/.agent-notes/
/.dsh-vision-router/
/.tmp-vercel-data/
/.tmp-vercel-config/
/.vercel.bak-owner/
/deploy-staging/blender-modal/out/
/deploy-staging/blender-director-persona/__pycache__/
# 帳號池數據（含明文帳密+token，永不入庫）
/pixai-pool-new.json
/IMG_*.jpg
/dreamina_output.webp
/chat-history-export-*.zip
/gh_repo.json
/reddit-miner-output.md
/rt4b-log.md
/batch-*.json
/.batch-*.json
/.probe-write-test.txt
/fix-system.sh
.av-implementation-spec.md
.tmp-*

# asset cache (mocap/shake 數據快取，不入庫)
.asset-cache/

# 評測證據大檔留本地（22MB PNG/mp4），只入 REPORT.md

# 憑證與 VPS 同步工作目錄（含 key，嚴禁入庫）
/.flowmusic-creds.json
/staging/
/deploy-staging/*
# 例外：gateway/ 子目錄是純程式碼真源（生產 index.ts 快照＋記憶模組，PRD D7），不含憑證
!/deploy-staging/gateway/
# 例外：laya-server/ 是 Jev 兜底判定服務純程式碼（server.py/Dockerfile），不含憑證與權重
!/deploy-staging/laya-server/
# 例外：vps-tools/ 是 VPS 運維工具純程式碼（gateway 對賬腳本等），不含憑證
!/deploy-staging/vps-tools/
# 例外：opencode-runtime/ 是 /opt/agent-harness/workspace/.opencode 手維護子集（tools/lib/skills/plugin
# ＋設定檔）的單一真源；vendored 的 node_modules/services 與執行時 opencode.db 已排除（見該目錄 .gitignore）
!/deploy-staging/opencode-runtime/
# 例外：poller/ 是 /opt/agent-harness/poller（生產常駐輪詢程式）的唯一真源；此前無 repo 真源導致
# 影片命名空間 bug 存活至今（2026-10-02 修）。純程式碼，不含憑證
!/deploy-staging/poller/
# 例外：flowmusic2api/ 是 FlowMusic 帳號池服務的 P1/P2 憑證鏈修復補丁＋看門狗的真源；
# 此前補丁只在本機 /tmp、看門狗只在 VPS（同 agent-poller 的無真源陷阱）。
# 純程式碼/補丁/測試，不含憑證
!/deploy-staging/flowmusic2api/
*.bak-*

# ── 影片產物（本機渲染輸出，200MB 級，2026-09-27 commit 瘦身）──
# artifacts/：宣傳片 mp4/webm 與 vote-kit 交付物；promo-video/out/：分段渲染 segN.mkv/stills/score.wav。
# 兩者都是可重跑的本機產物，源碼（promo-video/audio.py、render.mjs、index.html）照常入庫。
/artifacts/
/promo-video/out/
# 宣傳片渲染用的 CJK 字型（兩支 NotoSerifSC OTF 共 23MB）：本機工具鏈的輸入，
# 不是產品資產，且體積等同半個倉庫 ⇒ 不入庫（重跑渲染前先自行放回 promo-video/fonts/）。
/promo-video/fonts/

# ── 產品發展史（史官編撰，本地留存，不入庫）──
/PRODUCT-HISTORY.md
