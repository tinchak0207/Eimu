#!/bin/bash
# ============================================================================
# ffmpeg 全域跨进程限流 shim（2026-10-02 VPS OOM 治本 — 扩充 opencode 工具路）
#
# 背景：2026-10-02 08:36 全域 OOM 的 12 个 ffmpeg 全为 uid 995（agentsvc，
# 即 opencode-server 及其工具/沙箱），gateway（ubuntu, uid 1000）的进程内
# 讯号量（gateway/ffmpeg-limiter.ts）覆盖不到。本 shim 放在 ffmpeg 二进位
# 真源路径上，让**所有** ffmpeg 呼叫（gateway 与 opencode 工具路皆走此路径）
# 共用同一组跨进程 slot。
#
# 语义复用 gateway/ffmpeg-limiter.ts（不另造判准）：
#   1. 并发上限 FFMPEG_MAX_CONCURRENT（预设 2；0 = 关闭限流）
#   2. 放行前 MemAvailable >= FFMPEG_MIN_MEM_MB（预设 400）
# 以 flock 占 N 个 slot 档达成跨进程/跨使用者上限；放行后 exec 真二进位，
# slot fd 续持，ffmpeg 结束即自动释放。真二进位在 ./real/ffmpeg。
# ============================================================================
set -u

REAL="/opt/agent-harness/bin/real/ffmpeg"
GATE="/opt/agent-harness/bin/.ffmpeg-gate"
MAX="${FFMPEG_MAX_CONCURRENT:-2}"
MIN="${FFMPEG_MIN_MEM_MB:-400}"

# 探测型旗标（detectFfmpeg 的 `ffmpeg -version` 等）不过闸，避免版本探测被编码阻塞
case "${1:-}" in
  -version|-buildconf|-formats|-codecs|-decoders|-encoders|-filters|-pix_fmts|-layouts|-h|-help|--help|-L)
    exec "$REAL" "$@";;
esac

case "$MAX" in ''|*[!0-9]*) MAX=2;; esac
[ "$MAX" -eq 0 ] && exec "$REAL" "$@"
[ -d "$GATE" ] || exec "$REAL" "$@"   # fail-open：gate 目录缺失不阻断可用性

mem_ok() {
  local m
  m=$(awk '/^MemAvailable:/{print int($2/1024); exit}' /proc/meminfo 2>/dev/null)
  [ -z "$m" ] && return 0             # 读不到 → 不因记忆体条件阻塞
  [ "$m" -ge "$MIN" ]
}

i=0
while :; do
  slot=$(( i % MAX )); i=$(( i + 1 ))
  slotfile="$GATE/slot$slot.lock"
  [ -r "$slotfile" ] || exec "$REAL" "$@"   # fail-open：slot 档不可读
  exec 9<"$slotfile"
  if flock -n 9 2>/dev/null; then
    if mem_ok; then
      exec "$REAL" "$@"               # fd 9 续持 → ffmpeg 结束自动释放
    fi
    flock -u 9 2>/dev/null
  fi
  exec 9<&-
  sleep 0.3
done
