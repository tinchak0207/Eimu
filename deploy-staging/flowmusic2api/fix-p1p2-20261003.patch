+// P2: when Supabase rotation succeeds but provider_token is unusable, the
+// rotated Supabase JWT cookie must be persisted (and generation must be able to
+// authenticate with it) even though the FlowMusic bearer update is skipped.
+func TestRefreshAccountPersistsRotatedJWTCookieWhenProviderTokenMissing(t *testing.T) {
+	ctx := context.Background()
+
+	supabaseServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		writeTestJSON(t, w, map[string]any{
+			"access_token":  "supabase-access",
+			"refresh_token": "rotated-refresh-token",
+			"expires_in":    3600,
+			"user":          map[string]any{"email": "jwt-only@example.test"},
+		})
+	}))
+	t.Cleanup(supabaseServer.Close)
+
+	dir := t.TempDir()
+	cfg := config.Config{
+		DataDir:              dir,
+		DatabaseDriver:       "sqlite",
+		DatabaseURL:          filepath.Join(dir, "flowmusic2api.db"),
+		// FlowMusic is intentionally unreachable: the JWT cookie must survive
+		// regardless of whether the FlowMusic bearer can be refreshed.
+		FlowMusicBaseURL:     "http://127.0.0.1:1",
+		SupabaseBaseURL:      supabaseServer.URL,
+		SupabaseAnonKey:      "anon-key",
+		UpstreamTimeout:      time.Second,
+		GenerationTimeout:    time.Second,
+		TokenRefreshLead:     time.Minute,
+		TokenRefreshInterval: time.Hour,
+		DefaultAdminUser:     "admin",
+		DefaultAdminPassword: "admin",
+		DefaultAPIKey:        "test-api-key",
+	}
+	db, err := store.New(ctx, cfg)
+	if err != nil {
+		t.Fatalf("store.New() error = %v", err)
+	}
+	t.Cleanup(func() { _ = db.Close() })
+	if err := db.Migrate(ctx); err != nil {
+		t.Fatalf("Migrate() error = %v", err)
+	}
+	if err := db.EnsureDefaults(ctx); err != nil {
+		t.Fatalf("EnsureDefaults() error = %v", err)
+	}
+	id, err := db.CreateAccount(ctx, domain.Account{
+		Email:              "jwt-only@example.test",
+		ProtocolMode:       "refresh_token",
+		RefreshToken:       "old-refresh-token",
+		AutoRefreshEnabled: true,
+	})
+	if err != nil {
+		t.Fatalf("CreateAccount() error = %v", err)
+	}
+
+	accounts := NewAccountService(cfg, db, NewFlowMusicClient(cfg))
+	if _, err := accounts.RefreshAccount(ctx, id); err == nil {
+		t.Fatalf("RefreshAccount() error = nil, want the provider_token signal error (kept by contract)")
+	}
+	stored, err := db.GetAccount(ctx, id)
+	if err != nil {
+		t.Fatalf("GetAccount() error = %v", err)
+	}
+	if stored.RefreshToken != "rotated-refresh-token" {
+		t.Fatalf("rotated refresh token not persisted: %q", stored.RefreshToken)
+	}
+	if stored.ExpiresAt == nil || !stored.ExpiresAt.After(time.Now().UTC()) {
+		t.Fatalf("expires_at did not advance: %+v", stored.ExpiresAt)
+	}
+	if got := extractSupabaseJWT(stored.Cookies); got != "supabase-access" {
+		t.Fatalf("rotated JWT cookie not persisted: %q", stored.Cookies)
+	}
+	// Behavioural oracle: generation headers must carry the fresh Supabase JWT.
+	req, err := http.NewRequest(http.MethodGet, "http://example.test/", nil)
+	if err != nil {
+		t.Fatalf("NewRequest() error = %v", err)
+	}
+	NewFlowMusicClient(cfg).applyFlowHeaders(req, stored)
+	if auth := req.Header.Get("Authorization"); auth != "Bearer supabase-access" {
+		t.Fatalf("generation Authorization = %q, want Bearer supabase-access", auth)
+	}
+}
