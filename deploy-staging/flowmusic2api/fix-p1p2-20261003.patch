+func extractJWTExpiry(jwt string) *time.Time {
+	parts := strings.SplitN(jwt, ".", 3)
+	if len(parts) < 2 {
+		return nil
+	}
+	raw := parts[1]
+	data, err := base64.RawURLEncoding.DecodeString(strings.TrimRight(raw, "="))
+	if err != nil {
+		pad := (4 - len(raw)%4) % 4
+		data, err = base64.StdEncoding.DecodeString(raw + strings.Repeat("=", pad))
+		if err != nil {
+			return nil
+		}
+	}
+	var claims struct {
+		Exp int64 `json:"exp"`
+	}
+	if err := json.Unmarshal(data, &claims); err != nil || claims.Exp <= 0 {
+		return nil
+	}
+	t := time.Unix(claims.Exp, 0).UTC()
+	return &t
+}
