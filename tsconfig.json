{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "target": "ES2017"
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tools/**/*.ts",
    "tools/**/*.mts",
    "worker/**/*.ts",
    "tailwind.config.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "tmp",
    "eval-*",
    "src/vendor-bridges",
    "staging",
    "open-source",
    "work",
    "**/*.test.ts",
    "**/*.test.tsx",
    "apps",
    "services",
    "tools/vendor",
    "tools/plugins",
    "tools/qa",
    "tools/promo-video",
    ".local",
    "bridge",
    "deploy-staging",
    "bench",
    "tools/generated",
    "tools/archive"
  ]
}
